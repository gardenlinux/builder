#!/usr/bin/env bash

set -euo pipefail

features_dir="${FEATURES_DIR:-/builder/features}"

# Built-in keys. requirements.mod scripts may extend this array via:
#   requirements["some_key"]=some_value
# and requirements.defs can set defaults to apply before any feature
# specific values are set. this is also the place to define keys that
# should exists with blank/default values even if no feature sets it
declare -A requirements
requirements["arch"]="$BUILDER_ARCH"

req_def=/builder/requirements.defs
# shellcheck source=/dev/null
[ -e "$req_def" ] && source "$req_def"

# Source only the selected features' requirements.mod files,
# allowing them to override the defaults set above.
IFS=',' read -r -a features <<< "$BUILDER_FEATURES"
for feature in "${features[@]}"; do
	[ -z "$feature" ] && continue
	req_mod="$features_dir/$feature/requirements.mod"
	# shellcheck source=/dev/null
	[ -e "$req_mod" ] && source "$req_mod"
done

# Emit each key alphabetically
for key in "${!requirements[@]}"; do
	printf '%s=%s\n' "$key" "${requirements[$key]}"
done | sort > "$2"
