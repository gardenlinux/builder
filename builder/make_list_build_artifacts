#!/usr/bin/env bash

set -euo pipefail
shopt -s nullglob

versioned_flavor="$1"

IFS=',' read -r -a features < <(./parse_features --allow-frankenstein --feature-dir features --target "$versioned_flavor" features)

artifacts=(".build/$versioned_flavor-$COMMIT.tar" ".build/$versioned_flavor-$COMMIT.release" ".build/$versioned_flavor-$COMMIT.manifest" ".build/$versioned_flavor-$COMMIT.sbom" ".build/$versioned_flavor-$COMMIT.requirements")

for feature in "${features[@]}"; do
	for i in "features/$feature/"{image,convert}.*; do
		# get target artifact file extension, usually this is the image/convert script extension
		# except if the script extension is of the form filename.extA~extB in which case the artifact extension is .extA only
		extension="$(grep -E -o '(\.[a-z][a-zA-Z0-9\-_~]*)*$' <<< "$i")"
		artifacts+=(".build/$versioned_flavor-$COMMIT${extension%~*}")
	done
done

if [ "${#artifacts[@]}" = 5 ] && [ -n "$(./parse_features --allow-frankenstein --feature-dir "features" --target "$versioned_flavor" platforms)" ]; then
	artifacts+=(".build/$versioned_flavor-$COMMIT.raw")
fi

echo "${artifacts[@]}"
